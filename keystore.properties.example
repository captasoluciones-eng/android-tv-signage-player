# Copy this file to "keystore.properties" (same folder, project root) and fill in
# the values produced by the `keytool` command in README.md. That file is read by
# app/build.gradle.kts to wire the release signing config. Never commit the real
# keystore.properties or the .jks/.keystore file to version control.

storeFile=../signage-release.jks
storePassword=CHANGE_ME
keyAlias=signage-release
keyPassword=CHANGE_ME
